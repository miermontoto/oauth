{
  "name": "oauth",
  "private": true,
  "type": "module",
  "author": "Juan Mier",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup && mkdir -p dist/db && rm -rf dist/db/migrations && cp -r src/db/migrations dist/db/",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "@node-rs/argon2": "^2.0.0",
    "@platform/auth": "workspace:*",
    "@platform/core-api": "workspace:*",
    "@platform/db": "workspace:*",
    "@simplewebauthn/server": "^13.1.0",
    "better-sqlite3": "^11.8.0",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.38.0",
    "hono": "^4.7.0",
    "jose": "^5.9.6",
    "nodemailer": "^6.9.16",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@platform/config": "workspace:*",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.17",
    "drizzle-kit": "^0.31.9",
    "tsup": "^8.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.9"
  }
}
