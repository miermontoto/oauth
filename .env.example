# --- básicos ---
# NODE_ENV=production
# PORT=3000
# ruta del fichero sqlite (default ./data/oauth.db; en docker /app/data/oauth.db)
# DATABASE_PATH=./data/oauth.db
# url pública del emisor: el "iss" de todos los tokens. obligatoria en prod.
# ISSUER_URL=https://id.mier.info
# emails admin (coma-separados). RECOMENDADO en prod: si se define, SOLO estos
# usuarios son admin. sin definir, el primer usuario registrado se hace admin
# (cómodo en local, pero en un idp público expuesto es una escalada de privilegios).
# ADMIN_EMAILS=juan.mier@okticket.es

# --- email (opcional: sin smtp, los enlaces de verificación/reset se loguean) ---
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# SMTP_FROM="mier id <id@mier.info>"

# --- login social upstream (un proveedor se activa si su par de credenciales existe) ---
# cada proveedor necesita su propia app oauth registrada con el callback de mier id
# (NO reutilizar las de otras apps: el redirect_uri no coincide).
# google: cloud console → credentials → OAuth client ID (Web application),
#   authorized redirect URI = https://id.mier.info/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# github: settings → developer settings → OAuth Apps (NO GitHub App),
#   authorization callback URL = https://id.mier.info/callback/github
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# apple: developer.apple.com → Certificates, Identifiers & Profiles
#   1. Identifiers → App ID con la capability "Sign in with Apple"
#   2. Identifiers → Services ID (su identifier es el client_id) → Sign in with Apple →
#      primary App ID = el anterior, domain = id.mier.info,
#      return URL = https://id.mier.info/callback/apple
#      (apple exige https y dominio real: no admite localhost)
#   3. Keys → nueva key con "Sign in with Apple" → descarga el .p8 (solo una vez) y anota su Key ID
#   Team ID: en Membership details de la cuenta de developer
# APPLE_CLIENT_ID=info.mier.id.web
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# contenido del .p8 en una sola línea, con los saltos escapados como \n
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIGTAgEA...\n-----END PRIVATE KEY-----"

# trazas + logs a openobserve (platform/tooling/observability). vacío = sin export: las
# trazas siguen en proceso (trace id en los logs y en el header x-trace-id)
OTEL_EXPORTER_OTLP_ENDPOINT=
# Authorization=Basic <base64 de email:password del .env de openobserve>
OTEL_EXPORTER_OTLP_HEADERS=
# LOG_LEVEL=info          # debug|info|warn|error|silent
# LOG_FORMAT=pretty       # pretty ([scope] mensaje) | json (una línea por registro)
# DB_SLOW_QUERY_MS=100    # umbral del log de query lenta
# HTTP_SLOW_MS=1000       # umbral para que el access log suba a warn
