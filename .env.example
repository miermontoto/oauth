# --- básicos ---
# NODE_ENV=production
# PORT=3000
# ruta del fichero sqlite (default ./data/oauth.db; en docker /app/data/oauth.db)
# DATABASE_PATH=./data/oauth.db
# url pública del emisor: el "iss" de todos los tokens. obligatoria en prod.
# ISSUER_URL=https://id.mier.info
# emails admin (coma-separados). RECOMENDADO en prod: si se define, SOLO estos
# usuarios son admin. sin definir, el primer usuario registrado se hace admin
# (cómodo en local, pero en un idp público expuesto es una escalada de privilegios).
# ADMIN_EMAILS=juan.mier@okticket.es

# --- email (opcional: sin smtp, los enlaces de verificación/reset se loguean) ---
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# SMTP_FROM="mier id <id@mier.info>"

# --- login social upstream (un proveedor se activa si su par de credenciales existe) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
